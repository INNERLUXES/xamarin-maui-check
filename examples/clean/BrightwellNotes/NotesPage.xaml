<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BrightwellNotes.NotesPage"
             Title="Notes">
    <Grid RowDefinitions="Auto,*" Padding="12">
        <Entry x:Name="NewNote" Placeholder="A new note" Completed="OnNoteCompleted" />
        <CollectionView x:Name="NoteList" Grid.Row="1" />
    </Grid>
</ContentPage>
